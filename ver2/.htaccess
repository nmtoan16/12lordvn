Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)(tools|node_modules|tests|scripts|tasks|dist|test-results[^/]*)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]
</IfModule>
<FilesMatch "^(package(-lock)?\.json|playwright\.config\.cjs|SPEC\.md)$">
  Require all denied
</FilesMatch>
